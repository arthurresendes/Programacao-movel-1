<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginPrestadorActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="77dp"
        android:layout_marginTop="55dp"
        android:layout_marginEnd="77dp"
        android:layout_marginBottom="636dp"
        android:text="Olá, meu prestador"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="19dp"
        android:layout_marginTop="134dp"
        android:text="Digite seu e-mail"
        app:layout_constraintBottom_toTopOf="@+id/emailPrest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.465"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="1dp"
        android:text="Digite sua senha"
        app:layout_constraintBottom_toTopOf="@+id/senhaPrest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.465"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailPrest" />

    <EditText
        android:id="@+id/senhaPrest"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="21dp"
        android:layout_marginBottom="412dp"
        android:ems="10"
        android:inputType="textPassword"
        android:text="ex"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.438"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <EditText
        android:id="@+id/emailPrest"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="28dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:text="teste@gmail.com"
        app:layout_constraintBottom_toTopOf="@+id/textView4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.441"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <Button
        android:id="@+id/logarUserPrest"
        android:layout_width="184dp"
        android:layout_height="56dp"
        android:layout_marginStart="114dp"
        android:layout_marginTop="81dp"
        android:layout_marginEnd="114dp"
        android:layout_marginBottom="32dp"
        android:text="Logar"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@+id/limpUserPrest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/senhaPrest" />

    <Button
        android:id="@+id/limpUserPrest"
        android:layout_width="176dp"
        android:layout_height="48dp"
        android:layout_marginStart="114dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="114dp"
        android:layout_marginBottom="33dp"
        android:backgroundTint="#216106"
        android:text="Limpar"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@+id/sairUserPrest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logarUserPrest" />

    <Button
        android:id="@+id/sairUserPrest"
        android:layout_width="184dp"
        android:layout_height="56dp"
        android:layout_marginStart="114dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="114dp"
        android:layout_marginBottom="94dp"
        android:backgroundTint="#990606"
        android:text="Sair"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/limpUserPrest" />

</androidx.constraintlayout.widget.ConstraintLayout>