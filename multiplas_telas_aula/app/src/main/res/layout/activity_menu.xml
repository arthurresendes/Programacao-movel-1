<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MenuActivity">

    <Button
        android:id="@+id/logCliente"
        android:layout_width="183dp"
        android:layout_height="60dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="256dp"
        android:layout_marginEnd="121dp"
        android:layout_marginBottom="74dp"
        android:text="Logar como cliente"
        app:layout_constraintBottom_toTopOf="@+id/logPrestador"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/logPrestador"
        android:layout_width="191dp"
        android:layout_height="55dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="74dp"
        android:layout_marginEnd="121dp"
        android:layout_marginBottom="305dp"
        android:text="Logar como prestador"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logCliente" />
</androidx.constraintlayout.widget.ConstraintLayout>