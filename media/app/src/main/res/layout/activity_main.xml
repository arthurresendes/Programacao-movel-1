<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Média Mobile 1"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:layout_marginTop="10px"
            android:layout_marginRight="10px"
            android:text="Atividade" />

        <EditText
            android:id="@+id/atividade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:ems="10"
            android:inputType="text"
            android:text="Nota da atividade"
            android:textColor="#B4B4B4" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:layout_marginTop="10px"
            android:layout_marginRight="10px"
            android:text="Prova 1" />

        <EditText
            android:id="@+id/prova1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:ems="10"
            android:inputType="text"
            android:text="Nota da prova 1"
            android:textColor="#B4B4B4" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:layout_marginTop="10px"
            android:layout_marginRight="10px"
            android:text="Prova 2" />

        <EditText
            android:id="@+id/prova2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:ems="10"
            android:inputType="text"
            android:text="Nota da prova 2"
            android:textColor="#B4B4B4" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:layout_marginTop="10px"
            android:layout_marginRight="10px"
            android:text="Faltas" />

        <EditText
            android:id="@+id/faltas"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:ems="10"
            android:inputType="text"
            android:text="Quantidade de faltas"
            android:textColor="#B4B4B4" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:layout_marginTop="40px"
            android:layout_marginRight="10px"
            android:text="Situação"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/situacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:layout_marginTop="10px"
            android:layout_marginRight="10px"
            android:textAlignment="center"
            android:textSize="16sp" />

        <Button
            android:id="@+id/calcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50sp"
            android:layout_marginTop="10sp"
            android:layout_marginRight="50sp"
            android:backgroundTint="#009688"
            android:hyphenationFrequency="normal"
            android:text="Calcular" />

        <Button
            android:id="@+id/limpar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50sp"
            android:layout_marginTop="10px"
            android:layout_marginRight="50sp"
            android:backgroundTint="#3F51B5"
            android:text="Limpar" />

        <Button
            android:id="@+id/sair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50sp"
            android:layout_marginTop="10sp"
            android:layout_marginRight="50sp"
            android:backgroundTint="#E91E63"
            android:text="Sair" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>