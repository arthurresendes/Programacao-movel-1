<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTituloMovimentacao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nova movimentação"
                android:textColor="#26332C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btFechar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="×"
                android:textColor="#89958D"
                android:textSize="28sp"
                android:contentDescription="Fechar" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/barra_busca"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btDespesa"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/filtro_ativo"
                android:gravity="center"
                android:text="Despesa"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btReceita"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/filtro_inativo"
                android:gravity="center"
                android:text="Receita"
                android:textColor="#89958D"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/fundo_saldo"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvRotuloValor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valor da despesa"
                android:textColor="#DCEFE6"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etValor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="2dp"
                android:background="@android:color/transparent"
                android:hint="R$ 0,00"
                android:inputType="numberDecimal"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#DCEFE6"
                android:textSize="28sp"
                android:textStyle="bold"
                android:selectAllOnFocus="true" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Descrição"
            android:textColor="#26332C"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescricao"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/barra_busca"
            android:hint="Ex.: Compra no supermercado"
            android:inputType="textCapSentences"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#26332C"
            android:textColorHint="#89958D"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Categoria"
            android:textColor="#26332C"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btCategoria"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/barra_busca"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icone_categoria"
                android:gravity="center"
                android:text="⌂"
                android:textColor="#16865B"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/tvCategoriaSelecionada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Selecionar categoria"
                android:textColor="#536159"
                android:textSize="13sp" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#89958D"
                android:textSize="25sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btData"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/barra_busca"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="▦"
                android:textColor="#16865B"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Data do registro"
                    android:textColor="#536159"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDataSelecionada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hoje"
                    android:textColor="#26332C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Data preenchida automaticamente"
                    android:textColor="#89958D"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/fundo_saldo"
                android:gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/btSalvarMovimentacao"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/botao_koin"
            android:gravity="center"
            android:text="Salvar movimentação"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</ScrollView>
