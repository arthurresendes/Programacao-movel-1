<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F4"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABEÇALHO VERDE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="316dp"
            android:background="@drawable/fundo_koin"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">


            <ImageView
                android:id="@+id/ivLogoKoin"
                android:layout_width="240dp"
                android:layout_height="115dp"
                android:layout_marginBottom="0dp"
                android:contentDescription="Logo Koin"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_transparente" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="4dp"
                android:text="Bem-vindo de volta!"
                android:textColor="#FFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="4dp"
                android:text="Faça login para continuar cuidando do seu futuro"
                android:textColor="#FFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- FORMULÁRIO BRANCO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="442dp"
            android:layout_marginTop="-28dp"
            android:background="@drawable/card_koin"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="30dp"
            android:paddingEnd="26dp"
            android:paddingBottom="32dp">

            <!-- E-MAIL -->

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/fundo_koin"
                android:drawableStart="@drawable/icone_email"
                android:drawablePadding="12dp"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#26332C"
                android:textColorHint="#89958D"
                android:textSize="15sp" />

            <!-- SENHA -->
            <EditText
                android:id="@+id/etSenha"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/fundo_koin"
                android:drawableStart="@drawable/icone_senha"
                android:drawablePadding="12dp"
                android:hint="Senha"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#26332C"
                android:textColorHint="#89958D"
                android:textSize="15sp" />


            <!-- BOTÃO ENTRAR -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/botao_koin"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- DIVISOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0E7E1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="ou"
                    android:textColor="#89958D"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0E7E1" />

            </LinearLayout>

            <!-- CRIAR CONTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ainda não tem uma conta?"
                    android:textColor="#68776E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvCriarConta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:padding="6dp"
                    android:text="Criar conta"
                    android:textColor="#16865B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- RODAPÉ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="KOIN · Sua vida financeira em equilíbrio."
            android:textColor="#89958D"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
