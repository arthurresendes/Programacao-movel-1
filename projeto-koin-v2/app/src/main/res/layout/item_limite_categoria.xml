<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomeCategoriaLimite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoria"
            android:textColor="#26332C"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGastoCategoriaLimite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Gasto este mês: R$ 0,00"
            android:textColor="#89958D"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="136dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/barra_busca"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$"
            android:textColor="#89958D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLimiteCategoria"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:digits="0123456789,."
            android:gravity="center_vertical|end"
            android:hint="0,00"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLength="12"
            android:paddingStart="6dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textColor="#26332C"
            android:textColorHint="#B5BDB8"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>