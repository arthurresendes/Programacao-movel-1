<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/card_koin"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvIconeMeta"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:textSize="25sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomeMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#26332C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvValorMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#89958D"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progressoMeta"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="10dp"
            android:max="100" />

        <TextView
            android:id="@+id/tvPercentualMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvPrazoMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#89958D"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnOpcoesMeta"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="-6dp"
        android:layout_marginEnd="-8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Opções da meta"
        android:padding="8dp"
        android:src="@drawable/ic_mais_opcoes" />

</LinearLayout>